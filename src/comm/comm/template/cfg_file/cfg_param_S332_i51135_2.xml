                <LidarLocWio correctPeriod = "0.001">
                    <LidarTopicList>
                        <LidarTopic name="/MainLidar/car_filtered_points" />
                    </LidarTopicList>
                    <Registerer type="0" minScore="0.7" srcCloudRes="2.0">
