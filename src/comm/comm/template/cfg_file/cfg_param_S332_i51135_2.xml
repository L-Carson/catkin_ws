                        </LidarTopicList>
                    </Lio>
                    <Registerer type="0" minScore="0.7" srcCloudRes="2.0">
                        <OmpNdt resolution="1.0" stepSize="1.0" transEps="0.01" maxIter="50" threadNum="1" />
                        <MixNdt rawResolution="1.0" fineResolution="0.5" stepSize="0.1" transEps="0.01" outlierThr="20.0" maxIter="20" threadNum="1" srcCloudDsRes="2.0" />
